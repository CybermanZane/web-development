{
  "name": "restaurant-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "server:dev": "node node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build && node node_modules/typescript/bin/tsc -p server/tsconfig.json",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc -p server/tsconfig.json --noEmit",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "start": "node server/dist/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "framer-motion": "^12.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7"
  }
}
